{{- define "flyermiles-lib.name" -}}
{{- .Values.nameOverride | default .Chart.Name -}}
{{- end -}}

{{- define "flyermiles-lib.labels" -}}
app.kubernetes.io/name: {{ include "flyermiles-lib.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
app.kubernetes.io/part-of: flyermiles
app.kubernetes.io/version: {{ .Values.image.tag | quote }}
helm.sh/chart: {{ .Chart.Name }}-{{ .Chart.Version }}
{{- end -}}

{{- define "flyermiles-lib.selectorLabels" -}}
app.kubernetes.io/name: {{ include "flyermiles-lib.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end -}}

{{/* Environment shared by every Java service: Kafka, registry, DB credentials, OpenTelemetry. */}}
{{- define "flyermiles-lib.env" -}}
- name: JAVA_TOOL_OPTIONS
  value: {{ .Values.javaOpts | quote }}
- name: KAFKA_BOOTSTRAP
  value: {{ .Values.global.kafkaBootstrap | quote }}
- name: REGISTRY_URL
  value: {{ .Values.global.registryUrl | quote }}
- name: SPRING_KAFKA_ADMIN_AUTO_CREATE
  value: "false"
{{- if .Values.kafkaUser }}
# SCRAM credentials generated by the Strimzi User Operator for this service's KafkaUser.
- name: SASL_JAAS_CONFIG
  valueFrom:
    secretKeyRef:
      name: {{ .Values.kafkaUser }}
      key: sasl.jaas.config
- name: SPRING_APPLICATION_JSON
  value: '{"spring":{"kafka":{"security":{"protocol":"SASL_PLAINTEXT"},"properties":{"sasl.mechanism":"SCRAM-SHA-512","sasl.jaas.config":"${SASL_JAAS_CONFIG}"}}}}'
{{- end }}
{{- if .Values.database }}
- name: DB_USER
  valueFrom:
    secretKeyRef:
      name: {{ include "flyermiles-lib.name" . }}-db
      key: DB_USER
- name: DB_PASSWORD
  valueFrom:
    secretKeyRef:
      name: {{ include "flyermiles-lib.name" . }}-db
      key: DB_PASSWORD
{{- end }}
- name: OTEL_JAVAAGENT_ENABLED
  value: {{ .Values.global.otel.enabled | quote }}
- name: OTEL_SERVICE_NAME
  value: {{ include "flyermiles-lib.name" . }}
- name: OTEL_EXPORTER_OTLP_ENDPOINT
  value: {{ .Values.global.otel.endpoint | quote }}
- name: OTEL_RESOURCE_ATTRIBUTES
  value: "deployment.environment=kind,k8s.namespace.name=$(POD_NAMESPACE),k8s.pod.name=$(POD_NAME)"
# Keep 10% of traces (parent-based: a sampled trace is complete across every service). 100% of a
# million-event burst overwhelms a single Tempo.
- name: OTEL_TRACES_SAMPLER
  value: parentbased_traceidratio
- name: OTEL_TRACES_SAMPLER_ARG
  value: {{ .Values.global.otel.traceSampleRatio | default "0.1" | quote }}
{{- end -}}

{{- define "flyermiles-lib.podEnv" -}}
- name: POD_NAME
  valueFrom:
    fieldRef:
      fieldPath: metadata.name
- name: POD_NAMESPACE
  valueFrom:
    fieldRef:
      fieldPath: metadata.namespace
{{- end -}}
