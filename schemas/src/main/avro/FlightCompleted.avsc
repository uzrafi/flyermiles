{
  "type": "record",
  "name": "FlightCompleted",
  "namespace": "dev.flyermiles.avro",
  "doc": "v2: adds the optional 'cabin' field. v1 (no cabin) lives in src/test/resources for the evolution test.",
  "fields": [
    {"name": "eventId", "type": "string"},
    {"name": "memberId", "type": "string"},
    {"name": "flightNumber", "type": "string"},
    {"name": "origin", "type": "string"},
    {"name": "destination", "type": "string"},
    {"name": "distanceMiles", "type": "int"},
    {"name": "fareClass", "type": "string"},
    {"name": "completedAtMs", "type": "long"},
    {"name": "cabin", "type": ["null", "string"], "default": null}
  ]
}
